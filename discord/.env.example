# 読み上げ（任意。未設定なら括弧内の既定値）
# VOICEVOX への1リクエストのタイムアウト（ms, 30000）
# TTS_REQUEST_TIMEOUT_MS=30000
# サーバーごとの読み上げ待ちの上限件数。超えると古いものから捨てる（20）
# TTS_MAX_QUEUE_LENGTH=20
# 1メッセージで読み上げる最大文字数。超えた分は「以下省略」（400）
# TTS_MAX_MESSAGE_LENGTH=400
