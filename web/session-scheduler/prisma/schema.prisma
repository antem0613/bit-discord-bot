// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SchedulingStatus {
  SCHEDULING
  FINALIZED
  CANCELLED
  COMPLETED
}

enum SessionRoom {
  Room1
  Room2
  Room3
  Room4
  OtherServer
}

// 候補日ごとの参加者の回答記号（〇・△・×・？）
enum AvailabilitySymbol {
  CIRCLE
  TRIANGLE
  CROSS
  UNKNOWN
}

// Discordで認証したユーザー（対象サーバーのメンバー）
model Member {
  id          String  @id // Discord user ID
  username    String
  displayName String? // 対象サーバーでのサーバープロフィール（ニックネーム）
  // 個人用iCalフィードURLの秘密トークン（未発行ならnull。再発行で旧URLは無効になる）
  icalToken   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdEvents  Event[]            @relation("EventCreator")
  responses      ScheduleResponse[]
  participations EventParticipant[]
  comments       EventComment[]
}

model Event {
  id          String           @id @default(uuid())
  title       String
  description String
  status      SchedulingStatus @default(SCHEDULING)

  creator   Member @relation("EventCreator", fields: [creatorId], references: [id])
  creatorId String

  // 日程調整の回答期限（作成者が設定、任意）。期限を過ぎると自動的に締め切り扱いになる
  schedulingDeadline DateTime?
  // 作成者が任意のタイミングで手動締め切りした日時
  closedAt           DateTime?
  // 未回答者へのリマインドDMを最後に送った日時（連投防止のクールダウン判定に使う）
  lastRemindedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateDates EventCandidateDate[]
  symbolLabels   EventSymbolLabel[]
  responses      ScheduleResponse[]
  finalDates     EventFinalDate[]
  participants   EventParticipant[]
  comments       EventComment[]
}

// 日程調整の候補日。連続している必要はない
model EventCandidateDate {
  id      String   @id @default(uuid())
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  date    DateTime @db.Date

  responses ScheduleResponse[]

  @@unique([eventId, date])
}

// 回答記号(〇・△・×・？)ごとに作成者が設定する意味のラベル
model EventSymbolLabel {
  id      String             @id @default(uuid())
  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  symbol  AvailabilitySymbol
  label   String

  @@unique([eventId, symbol])
}

// 候補日ごとの参加者の回答。回答すること自体が参加表明を兼ねる
model ScheduleResponse {
  id String @id @default(uuid())

  candidateDate   EventCandidateDate @relation(fields: [candidateDateId], references: [id], onDelete: Cascade)
  candidateDateId String
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId        String

  symbol    AvailabilitySymbol
  // △のときだけ付けられる短いメモ（例: 「22時まで」）。全員に表示される
  note      String?            @db.VarChar(30)
  updatedAt DateTime           @updatedAt

  @@unique([candidateDateId, memberId])
}

// 最終確定した実施日（複数日・非連続も可）とセッション部屋の予約
model EventFinalDate {
  id      String       @id @default(uuid())
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  date    DateTime     @db.Date
  room    SessionRoom?
  // 開始・終了時刻（JST, "HH:mm"、任意）。終了は日付をまたぐ場合もあるため開始より前でもよい
  startTime String? @db.VarChar(5)
  endTime   String? @db.VarChar(5)

  @@unique([eventId, date])
  // 同日・同部屋の重複予約チェック用。キャンセル済みイベントは部屋を占有せず、「他サーバー」は
  // 同日に複数可のため、DBの一意制約ではなくアプリ側（findRoomConflicts）で判定する。
  @@index([date, room])
}

// イベント作成時（または編集時）にホストが指定した「参加者」。回答(ScheduleResponse)の有無に関わらず、
// そのイベントに参加予定であることを示す印として使う（例: イベント一覧の「参加イベント」フィルタ）。
// 一覧として見えるのは作成者だけ（未回答者の確認・リマインド用）。
model EventParticipant {
  id       String @id @default(uuid())
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
}

// イベントへのひとことコメント（1人1件、全員に表示）
model EventComment {
  id       String @id @default(uuid())
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String
  body     String @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
}
